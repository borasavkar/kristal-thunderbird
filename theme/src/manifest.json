      "popup_highlight_text": "#10131b",
      "sidebar": "#11141b",
      "sidebar_text": "#e9ecf3",
      "sidebar_border": "#2b3142",
      "sidebar_highlight": "#8f9dff",
      "sidebar_highlight_text": "#10131b"
