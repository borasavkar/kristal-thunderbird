{
  "manifest_version": 2,
  "name": "__MSG_themeName__",
  "description": "__MSG_themeDescription__",
  "version": "1.0.0",
  "author": "Bora Şavkar",
  "homepage_url": "https://github.com/borasavkar/kristal-thunderbird",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "kristal-theme@borasavkar.github.io",
      "strict_min_version": "128.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#e2e7ef",
      "frame_inactive": "#e9edf3",
