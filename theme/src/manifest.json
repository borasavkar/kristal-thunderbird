      "tab_text": "#161a24",
      "tab_line": "#3f4fd1",
      "toolbar": "#ebeef4",
      "toolbar_text": "#161a24",
      "toolbar_bottom_separator": "#d9dee8",
      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#161a24",
      "toolbar_field_border": "#bfc7d5",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#161a24",
      "toolbar_field_border_focus": "#3f4fd1",
      "toolbar_field_highlight": "#3f4fd1",
      "toolbar_field_highlight_text": "#ffffff",
      "icons": "#4f586b",
      "icons_attention": "#3f4fd1",
      "button_background_hover": "rgba(22, 26, 36, 0.07)",
      "button_background_active": "rgba(22, 26, 36, 0.13)",
      "popup": "#ffffff",
      "popup_text": "#161a24",
      "popup_border": "#bfc7d5",
