{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "Kristal",
  "description": "__MSG_extensionDescription__",
  "version": "1.0.2",
  "author": "Bora Şavkar",
  "homepage_url": "https://github.com/borasavkar/kristal-thunderbird",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "kristal@borasavkar.github.io",
      "strict_min_version": "158.0"
    }
  },
  "icons": {
    "32": "icons/kristal.svg",
    "64": "icons/kristal.svg"
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["common.js", "background.js"]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "experiment_apis": {
    "kristal": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["kristal"]],
        "script": "experiment/implementation.js",
        "events": ["startup"]
      }
    }
  }
}
